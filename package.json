{
  "name": "chordcamp-pro",
  "version": "1.0.0",
  "description": "Offline interactive guitar playground, 90+ chords, metal power chords, CAGED positions, scales, and pro metronome.",
  "main": "index.html",
  "scripts": {
    "start": "start ChordCamp.exe",
    "launch": "launch-windows.bat",
    "build:exe": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:winexe /r:System.Windows.Forms.dll /win32icon:assets\\ChordCamp.ico /out:ChordCamp.exe launcher\\ChordCampLauncher.cs",
    "build:installer": "node scripts/pack-installer.js && C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:winexe /r:System.Windows.Forms.dll,System.Drawing.dll,Microsoft.CSharp.dll,System.IO.Compression.dll,System.IO.Compression.FileSystem.dll /resource:installer\\ChordCampPayload.zip,ChordCampPayload.zip /win32icon:assets\\ChordCamp.ico /out:ChordCampSetup.exe installer\\ChordCampSetup.cs",
    "build": "npm run build:exe && npm run build:installer",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "keywords": [
    "guitar",
    "chords",
    "power-chords",
    "metal",
    "scales",
    "caged",
    "metronome",
    "offline"
  ],
  "author": "ChordCamp Team",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  }
}
