{
  "name": "chordcamp-pro",
  "version": "1.1.0",
  "description": "Offline interactive guitar playground, 133+ chords, studio guitar tuner, visual groove metronome, CAGED positions, and practice drills.",
  "main": "index.html",
  "scripts": {
    "start": "start ChordCamp.exe",
    "launch": "launch-windows.bat",
    "update": "Update-Windows.bat",
    "build": "python scripts/pack_all.py",
    "build:exe": "python -m PyInstaller --noconsole --onefile --icon=assets/ChordCamp.ico --name=ChordCamp launcher/desktop_app.py",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "npx cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "keywords": [
    "guitar",
    "chords",
    "power-chords",
    "metal",
    "scales",
    "caged",
    "metronome",
    "offline"
  ],
  "author": "ChordCamp Team",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0"
  }
}
